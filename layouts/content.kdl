layout {
    pane split_direction="vertical" {
        pane command="bash" args="-c" "cd $HOME/git/reelforge && penv && ./run_pipelines.sh; exec bash"
        pane split_direction="horizontal" {
            pane command="bash" args="-c" "cd $HOME/git/pub_yt_x && penv && python main.py; exec bash"
            pane command="bash" args="-c" "cd $HOME/git/solvechessdotcom && penv && ./run_app.sh; exec bash"
        }
    }
}