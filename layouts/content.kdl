layout {
    tab name="reelforge" {
        pane size=1 split_direction="vertical" {
            pane command="bash" cwd="~/git/reelforge" args "-c" "source venv/bin/activate && ./run_pipelines.sh; exec bash"
            pane size=1 split_direction="horizontal" {
                pane command="bash" cwd="~/git/pub_yt_x" args "-c" "source venv/bin/activate && python main.py; exec bash"
                pane command="bash" cwd="~/git/solvechessdotcom" args "-c" "source venv/bin/activate && ./run_app.sh; exec bash"
            }
        }
    }
}
